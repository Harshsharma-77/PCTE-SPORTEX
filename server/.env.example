# ==============================================================================
# PCTE SPORTEX - Server Environment Configuration
# ==============================================================================

# Server Network & Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Client Application URL (For CORS & WebSocket Origin Guard)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String (Direct or Pooled via Prisma)
# Example for local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pcte_sportex?schema=public"
# Example for Cloud PostgreSQL (Supabase / Neon / Render):
# DATABASE_URL="postgres://user:password@ep-cool-cloud.us-east-1.aws.neon.tech/pcte_sportex?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_pcte_sportex_2026_dev_mode
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_pcte_sportex_2026_dev_mode
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload / Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Super Admin Initial Bootstrap Credentials (Used during db seed)
SUPERADMIN_EMAIL=superadmin@pcte.edu.in
SUPERADMIN_PASSWORD=AdminPassword@2026
SUPERADMIN_NAME="PCTE Director of Sports"
